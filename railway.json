{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "setup": {
        "nixPkgs": ["nodejs_20"]
      },
      "install": {
        "cmds": ["cd server && npm install"]
      }
    },
    "buildCommand": "cd server && npm install"
  },
  "deploy": {
    "startCommand": "cd server && npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}